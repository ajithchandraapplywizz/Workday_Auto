{
  "strictMissingScripts": false,
  "defaultBase": "origin/main",
  "maxFileSizeMB": 5,
  "workspaces": [
    {
      "name": "root",
      "dir": ".",
      "scripts": {
        "lint": "npm run lint",
        "test": "npm test"
      }
    },
    {
      "name": "frontend",
      "dir": "frontend",
      "scripts": {
        "build": "npm run build"
      }
    }
  ],
  "smokeImportPrefixes": [
    "backend/lib"
  ],
  "smokeImportExclude": [
    "backend/lib/clusterBatchRunner.mjs",
    "backend/lib/workerPool.mjs",
    "backend/lib/submissionWorkerPool.mjs",
    "backend/lib/resolvingWorkerPool.mjs",
    "backend/lib/scanner.mjs",
    "backend/lib/engine.mjs",
    "backend/lib/workdayRapidAdvance.mjs"
  ],
  "blockedBranches": [
    "main",
    "master"
  ]
}
