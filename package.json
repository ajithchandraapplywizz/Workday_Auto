{
  "name": "workday-auto-apply",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.8.2",
  "main": "index.js",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "node index.js",
    "postinstall": "true",
    "setup": "node backend/cli.mjs setup",
    "scan": "node backend/cli.mjs scan",
    "fill": "node backend/cli.mjs fill",
    "apply": "node backend/cli.mjs apply",
    "batch": "node backend/cli.mjs batch",
    "queue": "node backend/cli.mjs queue",
    "submit": "node backend/scripts/queue_daemon.mjs submit",
    "status": "node backend/cli.mjs status",
    "test": "node --test backend/tests/clientQaRecord.test.mjs backend/tests/jobFormCache.test.mjs backend/tests/csvJobParser.test.mjs",
    "backend:dev": "node backend/cli.mjs",
    "frontend:dev": "npm --prefix frontend start",
    "build": "npm --prefix frontend run build",
    "dev": "node node_modules/vite/bin/vite.js frontend",
    "lint": "eslint . --ext .js,.mjs",
    "typecheck": "node --check backend/cli.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "dotenv": "^17.4.2",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.4.0",
    "typescript": "^5.3.3"
  }
}
