# ─── Apply Wizz ───────────────────────────────────────────────────────────────
# Your Apply Wizz candidate ID (e.g. AWL-XXXXX)
APPLYWIZZ_ID=

# The password used when creating/logging into Workday accounts on behalf of the candidate
WORKDAY_PASSWORD=

# ─── Anthropic Claude LLM (Only LLM) ──────────────────────────────────────────
# Key from https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=
# or ANTHROPIC_API_KEY=

# Default model: claude-haiku-5-5
ANTHROPIC_MODEL=claude-haiku-5-5

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Your Supabase project URL (e.g. https://xxxxxxxxxxxx.supabase.co)
SUPABASE_URL=

# Service-role key — NEVER expose this publicly. Use GitHub Secrets in CI.
SUPABASE_SERVICE_ROLE_KEY=
